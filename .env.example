# Copy this file to .env and fill in values.
# Never commit .env.

# Required. Works with OpenAI or any OpenAI-compatible server.
OPENAI_API_KEY=sk-your-key-here

# Optional. Leave unset to use the official OpenAI API.
# Examples: http://127.0.0.1:11434/v1  (Ollama)
#           https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Model id on the provider you configured.
OPENAI_MODEL=gpt-4o-mini

# chat = Chat Completions (most compatible)
# responses = OpenAI Responses API
OPENAI_API_STYLE=chat

LOG_LEVEL=INFO

# 0=answer only, 1=suggest tools, 2=ask before tools
AUTONOMY_LEVEL=2
MAX_STEPS=8
MAX_TOKENS_PER_RUN=50000
# How many times to ask the model to fix malformed JSON before giving up (0-5)
MAX_REPAIR_ATTEMPTS=2
