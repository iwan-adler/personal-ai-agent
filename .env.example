# Copy this file to .env and fill in values.
# Never commit .env.

# Required. Works with OpenAI or any OpenAI-compatible server.
OPENAI_API_KEY=sk-your-key-here

# Optional. Leave unset to use the official OpenAI API.
# Examples: http://127.0.0.1:11434/v1  (Ollama)
#           https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Model id on the provider you configured.
OPENAI_MODEL=gpt-4o-mini

# chat = Chat Completions (most compatible)
# responses = OpenAI Responses API
OPENAI_API_STYLE=chat

LOG_LEVEL=INFO

# 0=answer only, 1=suggest tools, 2=ask before tools (default),
# 3=auto-run SAFE tools, 4=also ask once per request for a CONFIRMATION tool grant
AUTONOMY_LEVEL=2
MAX_STEPS=8
MAX_TOKENS_PER_RUN=50000
# How many times to ask the model to fix malformed JSON before giving up (0-5)
MAX_REPAIR_ATTEMPTS=2
# Seconds to wait for one model API call (1-600); the SDK retries up to 2 more times
LLM_TIMEOUT_SECONDS=60
# How many recent messages are sent to the model each turn (4-200)
MAX_HISTORY_MESSAGES=20
# The only folder the file tools may read (absolute path). Leave empty for no file tools.
# It may not be a drive root, your home folder itself, or a folder containing this project.
WORKSPACE_DIR=
# Repos the read-only GitHub tools may reach, comma-separated owner/name (max 20).
# Leave empty for no GitHub tools.
GITHUB_REPOS=
# Optional. Recommended: a fine-grained token limited to those repos with read-only
# Metadata, Issues and Pull requests. Without it, public repos work (60 requests/hour).
GITHUB_TOKEN=
# Repos the agent may PUBLISH to (comments, new issues); must also be in GITHUB_REPOS.
# Every publish asks first and shows the full text. Leave empty for no write tools.
GITHUB_WRITE_REPOS=
# Required with GITHUB_WRITE_REPOS: a separate fine-grained token limited to those repos,
# with Issues: Read and write. Used only by the write tools.
GITHUB_WRITE_TOKEN=
